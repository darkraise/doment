<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>doment</AssemblyName>
    <PublishAot>true</PublishAot>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(DomentSimulation)' == 'true'">
    <DefineConstants>$(DefineConstants);DOMENT_SIMULATION</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Doment.Client/Doment.Client.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(DomentSimulation)' == 'true'">
    <ProjectReference Include="../Doment.Simulation/Doment.Simulation.csproj" />
  </ItemGroup>
</Project>
