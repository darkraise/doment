<Project>
  <!-- Set after the project body from the module map's Kind column; MSBuild ignores these assignments when
       DomentPlatform is a global property, so only -p:DomentPlatform=... overrides the list. -->
  <PropertyGroup>
    <DomentPlatform>portable</DomentPlatform>
    <DomentPlatform Condition="'$(MSBuildProjectName)' == 'Doment.Agent' or '$(MSBuildProjectName)' == 'Doment.Platform.Linux'">linux</DomentPlatform>
    <DomentPlatform Condition="'$(MSBuildProjectName)' == 'Doment.Platform.Windows' or '$(MSBuildProjectName)' == 'Doment.Service' or '$(MSBuildProjectName)' == 'Doment.Session' or '$(MSBuildProjectName)' == 'Doment.App'">windows</DomentPlatform>
  </PropertyGroup>

  <!-- NoWarn takes ';' and ',' as separators and its codes in any case. Each of the other properties turns
       CA1416 off or down when a project sets it in its own file; an AnalysisLevel ending in none disables
       every analyzer rule. -->
  <PropertyGroup Condition="'$(DomentPlatform)' == 'portable'">
    <NoWarn>$([System.Text.RegularExpressions.Regex]::Replace('$(NoWarn)', '(?i)(^|[;,\s])CA1416(?=$|[;,\s])', '$1'))</NoWarn>
    <RunAnalyzers>true</RunAnalyzers>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel Condition="$([System.String]::Copy('$(AnalysisLevel)').ToLowerInvariant().EndsWith('none'))">latest-recommended</AnalysisLevel>
    <AnalysisLevelInteroperability Condition="$([System.String]::Copy('$(AnalysisLevelInteroperability)').ToLowerInvariant().EndsWith('none'))"></AnalysisLevelInteroperability>
    <WarningsAsErrors>$(WarningsAsErrors);CA1416</WarningsAsErrors>
  </PropertyGroup>

  <UsingTask TaskName="DomentPortableAssemblyCheck"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <Task>
      <Code Type="Class" Language="cs" Source="$(MSBuildThisFileDirectory)Doment.PortableCheck.cs" />
    </Task>
  </UsingTask>

  <!-- No stamp: a failed check must fail again on the next build, when CoreCompile is up to date. -->
  <Target Name="DomentPortableAssemblyCheck"
          AfterTargets="CoreCompile"
          Condition="'$(DomentPlatform)' == 'portable' and '$(UsingMicrosoftNETSdk)' == 'true' and '$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_DomentPortableAssembly>@(IntermediateAssembly->'%(FullPath)')</_DomentPortableAssembly>
    </PropertyGroup>
    <DomentPortableAssemblyCheck AssemblyPath="$(_DomentPortableAssembly)"
                                 ProjectName="$(MSBuildProjectName)"
                                 Condition="Exists('$(_DomentPortableAssembly)')" />
  </Target>

  <Target Name="DomentPortableTargetFramework"
          BeforeTargets="_GenerateRestoreGraphProjectEntry;CollectPackageReferences"
          Condition="'$(DomentPlatform)' == 'portable' and '$(UsingMicrosoftNETSdk)' == 'true' and '$(TargetFramework)' != 'net10.0'">
    <PropertyGroup>
      <_DomentTargets>$(TargetFramework)</_DomentTargets>
      <_DomentTargets Condition="'$(_DomentTargets)' == ''">$(TargetFrameworks)</_DomentTargets>
    </PropertyGroup>
    <Error Code="DOMENT033"
           Text="$(MSBuildProjectName) is portable but targets $(_DomentTargets); portable projects target net10.0" />
  </Target>
</Project>
